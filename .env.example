# ===============================================================
# LLM BACKEND -- choose ONE of the options below (Groq recommended)
# ===============================================================

# --- OPTION 1: Groq Cloud (recommended -- fastest, free tier available) ---
# 1. Sign up at https://console.groq.com
# 2. Go to https://console.groq.com/keys  ->  "Create API Key"
# 3. Paste the key below  (starts with gsk_...)
GROQ_API_KEY=                            # <-- PUT YOUR GROQ KEY HERE
GROQ_MODEL=groq/llama-3.3-70b-versatile  # general completions + Stage 8 fn-call
GROQ_INTENT_MODEL=groq/llama3-8b-8192    # Stage 5 intent (fast small model)
# Popular Groq models (https://console.groq.com/docs/models):
#   groq/llama-3.3-70b-versatile  -- best quality  (recommended)
#   groq/llama3-70b-8192          -- very fast, good quality
#   groq/llama3-8b-8192           -- fastest / cheapest  (intent only)
#   groq/mixtral-8x7b-32768       -- large context window (32k tokens)
#   groq/gemma2-9b-it             -- lightweight alternative

# --- OPTION 2: vLLM / self-hosted endpoint (leave GROQ_API_KEY empty above) ---
# --- vLLM / Nemotron (primary; OpenAI-compatible) ---
# Base host only (no /v1). You can also paste a full chat URL; it is normalized.
# Examples: https://miniorangeai.miniorange.in  OR  http://miniorangeai.miniorange.in:8000
# Startup uses GET /v1/models and chat probe with redirect following (http→https, etc.).
VLLM_BASE_URL=https://miniorangeai.miniorange.in
# Leave empty if upstream requires no API key or Bearer token.
VLLM_API_KEY=
# Planner / Nemotron supervisor — use your server’s served model name (e.g. Nvidia Nemotron)
VLLM_PLANNER_MODEL=nvidia/nemotron-3-nano
VLLM_ASSISTANT_MODEL=nvidia/nemotron-3-nano
VLLM_CRITIC_MODEL=nvidia/nemotron-3-nano
VLLM_JUDGE_MODEL=nvidia/nemotron-3-nano
# VLLM_VISION_MODEL=  (optional, for image describe)
VLLM_TOOL_CALLING_MODE=auto
ALLOW_CLOUD_FALLBACK=false

# --- Fast intent LLM (optional; separate small model / endpoint for low-latency JSON intent) ---
# Stage 5 (intent extraction) routing precedence (top wins):
#   1. MISTRAL_API_KEY set  → Mistral cloud (uses MISTRAL_MODEL)
#   2. VLLM_INTENT_MODEL    → vLLM at VLLM_INTENT_BASE_URL or VLLM_BASE_URL
#   3. VLLM_PLANNER_MODEL   → same vLLM endpoint as #2
# VLLM_INTENT_MODEL=        # optional; defaults to VLLM_PLANNER_MODEL
# VLLM_INTENT_BASE_URL=     # optional; defaults to VLLM_BASE_URL
# INTENT_MAX_TOKENS=128
# INTENT_LLM_TIMEOUT=15.0
# INTENT_PROMPT_MAX_CHARS=2048
# INTENT_TEMPERATURE=0.0

# --- Operator LLM policies (natural language for Nemotron supervisor; OPA remains hard gate) ---
# Default: bundled Security Software LLM Guard YAML (security_software_llm_guard_policies.yaml).
# OPERATOR_LLM_POLICY_PATH=   # optional: path to .yaml/.yml (rendered) or .md/other (raw text)
# OPERATOR_LLM_POLICY_MAX_CHARS=12000   # increase if the rendered policy pack is truncated

# --- Optional cloud (only if ALLOW_CLOUD_FALLBACK=true) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o-mini

# --- Mistral cloud (Stage 5 intent extraction; takes precedence over vLLM intent) ---
# Get a key at https://console.mistral.ai/api-keys then paste it below.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral/mistral-small-latest
# MISTRAL_BASE_URL=        # leave empty for cloud; only set for self-hosted Mistral

# --- Agentic (Sentinel-X / Nemotron-first) ---
AGENTIC_MODE=true
# SUPERVISOR_MODE=react_primary   # react_primary | legacy_parallel_crew
# AGENT_PRESCAN=full_threat       # full_threat (11 scanners) | minimal | none
SUPERVISOR_MAX_STEPS=16
# MEMORY_RECALL_TOP_K=5
MAX_SUPERVISOR_STEPS=8
MAX_REFLECTIONS=2
MAX_OUTPUT_RETRIES=2

# --- Code sandbox (compose: code-sandbox) ---
CODE_SANDBOX_URL=http://code-sandbox:8888

# --- Auth ---
SENTINEL_API_KEY=demo-key

# --- Postgres ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinelguard
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinelguard

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- OPA ---
OPA_URL=http://opa:8181

# --- SIEM (optional) ---
SIEM_WEBHOOK_URL=

# --- Risk (0-100) ---
RISK_ALLOW_MAX=30
RISK_MASK_MAX=70
RISK_ESCALATE_MAX=90
REVIEW_TIMEOUT_SECONDS=30

# --- Frontend (Next.js dashboard) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_SENTINEL_KEY=demo-key
# NextAuth + dashboard login (also pass these into the frontend container if using compose)
AUTH_SECRET=generate-with-openssl-rand-base64-32
DASHBOARD_PASSWORD=sentinel

# ── Pipeline v2 (14-stage) ────────────────────────────────────────────────
PIPELINE_MODE=true

# Config YAML paths (relative to backend/ working dir)
TOOLS_YAML_PATH=tools.yaml
RISK_YAML_PATH=risk.yaml

# Mistral intent detector (Stage 5) — can point to local vLLM or HuggingFace
MISTRAL_MODEL=mistral/mistral-7b-instruct
# MISTRAL_BASE_URL=           # defaults to VLLM_BASE_URL if unset
# MISTRAL_TIMEOUT=8.0
# MISTRAL_MAX_TOKENS=256

# Nemotron function-call generator (Stage 8)
NEMOTRON_MODEL=nvidia/nemotron-mini-4b-instruct
# NEMOTRON_TIMEOUT=15.0
# NEMOTRON_MAX_TOKENS=512

# Short-term memory (Redis TTL)
STM_TTL_SECONDS=1800
STM_MAX_TURNS=5

# Tool API keys — leave blank to use simulate mode only
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com
TAVILY_API_KEY=
SLACK_BOT_TOKEN=
GITHUB_TOKEN=

# Tool execution timeouts (seconds)
# TOOL_DEFAULT_TIMEOUT=10
# TOOL_EMAIL_TIMEOUT=10
# TOOL_GITHUB_TIMEOUT=15
# TOOL_SLACK_TIMEOUT=10
# TOOL_SEARCH_TIMEOUT=30

# High-impact gate review window (seconds before auto-reject)
HIGH_IMPACT_REVIEW_TIMEOUT=300

# Qdrant (vector DB for jailbreak similarity + docs search)
QDRANT_URL=http://qdrant:6333

# Langfuse observability (optional; set LANGFUSE_ENABLED=true to activate)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
# Langfuse admin credentials (used by the Langfuse web UI container only)
LANGFUSE_NEXTAUTH_SECRET=changeme-in-prod
LANGFUSE_SALT=changeme-salt

# --- miniOrange Documentation Tool ---
# Absolute path to the miniorange-fastmcp/ directory (contains miniorange_docs.json + guides.json)
# Synthesis uses the existing VLLM_BASE_URL + VLLM_PLANNER_MODEL — no separate API key needed.
MINIORANGE_DATA_DIR=C:/Users/miniOrange/Projects/Ai Project/Agentic ai/miniorange-fastmcp
